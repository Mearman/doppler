{
  "name": "@mearman/doppler",
  "description": "Offline and real-time aircraft Doppler audio geolocation library, CLI, and PWA",
  "version": "0.1.0",
  "bin": {
    "doppler": "./dist-cli/doppler.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@vanilla-extract/css": "1.21.3",
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@exadev/eslint-config": "3.1.0",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/esbuild-plugin": "2.3.22",
    "@vitest/coverage-v8": "5.0.4",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "publint": "0.3.25",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/entry.d.ts",
      "import": "./dist/node/entry.js"
    },
    "./browser": {
      "types": "./dist/browser/entry.d.ts",
      "import": "./dist/browser/entry.js"
    }
  },
  "files": [
    "dist",
    "dist-cli"
  ],
  "keywords": [
    "acoustics",
    "ads-b",
    "audio",
    "doppler",
    "forensics",
    "geolocation",
    "osint",
    "signal-processing"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mearman/doppler.git"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint . --fix --cache --max-warnings 0",
    "lint:check": "eslint . --cache --max-warnings 0",
    "prepare": "husky",
    "prepublishOnly": "pnpm run lint:check && pnpm run build && pnpm run typecheck && pnpm run test && publint && attw --pack --profile esm-only",
    "site": "tsx site/build.ts",
    "test": "vitest run",
    "test:e2e": "pnpm run build && pnpm run site && playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.site.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.e2e.json"
  },
  "sideEffects": [
    "**/*.css.ts"
  ],
  "type": "module",
  "types": "./dist/index.d.ts"
}
