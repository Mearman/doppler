// Cloudflare config for the live ADS-B relay: a script-only Worker with no bindings.
// Deploy from the repository root with `pnpm deploy:worker`.
{
  "compatibility_date": "2026-11-01",
  "main": "relay.ts",
  "name": "doppler-adsb-relay",
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "workers_dev": true,
}
